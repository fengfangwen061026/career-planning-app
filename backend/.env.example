# PostgreSQL container settings used by docker compose.
# Keep POSTGRES_* consistent with DATABASE_URL.
POSTGRES_DB=career_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5433
REDIS_PORT=6379

# Database
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_strong_password@127.0.0.1:5433/career_planner

# Default LLM Configuration
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_API_KEY=your_stepfun_api_key_here
LLM_MODEL=step-3.5-flash
RESUME_PARSE_LLM_MODEL=step-2-mini

# Profile generation LLM Configuration
PROFILE_LLM_BASE_URL=https://api.stepfun.com/v1
PROFILE_LLM_API_KEY=your_stepfun_api_key_here
PROFILE_LLM_MODEL=step-3.5-flash

# Embedding Configuration
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v4

# Application
APP_NAME=Career Planner API
DEBUG=false
LLM_CONCURRENT_LIMIT=4
