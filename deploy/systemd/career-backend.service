[Unit]
Description=CareerAI FastAPI Backend
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/career-ai/app/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/career-ai/app/backend/.env
ExecStart=/opt/career-ai/app/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
